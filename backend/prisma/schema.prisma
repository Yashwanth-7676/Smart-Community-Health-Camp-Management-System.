// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  VOLUNTEER
  PATIENT
  ORGANIZER
}

enum CampStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
}

enum QueueStatus {
  WAITING
  CALLED
  COMPLETED
  SKIPPED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  REVOKED
}

enum ConsentType {
  TREATMENT
  DATA_SHARING
  RESEARCH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  EXPORT
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  EXPIRED
}

enum MedicineCategory {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  DROPS
  INHALER
  OTHER
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  password              String
  role                  Role                   @default(PATIENT)
  firstName             String
  lastName              String
  phone                 String?
  avatar                String?
  isActive              Boolean                @default(true)
  lastLoginAt           DateTime?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  patientProfile         PatientProfile?
  doctorProfile          DoctorProfile?
  volunteerProfile       VolunteerProfile?
  appointmentsAsPatient  Appointment[]          @relation("PatientAppointments")
  appointmentsAsDoctor   Appointment[]          @relation("DoctorAppointments")
  medicalReportsAsPatient MedicalReport[]       @relation("PatientReports")
  medicalReportsAsDoctor  MedicalReport[]       @relation("DoctorReports")
  referralsAsPatient     Referral[]             @relation("PatientReferrals")
  referralsAsDoctor      Referral[]             @relation("DoctorReferrals")
  notifications          Notification[]
  followUpsAsPatient     FollowUp[]             @relation("PatientFollowUps")
  followUpsAsDoctor      FollowUp[]             @relation("DoctorFollowUps")
  createdCamps           Camp[]
  consentRecords         ConsentRecord[]
  auditLogs              AuditLog[]
  staffAssignments       StaffAssignment[]
  inventoryTransactions  InventoryTransaction[]
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

model Camp {
  id               String            @id @default(cuid())
  name             String
  location         String
  address          String
  latitude         Float?
  longitude        Float?
  startDate        DateTime
  endDate          DateTime
  capacity         Int
  registered       Int               @default(0)
  status           CampStatus        @default(UPCOMING)
  services         String[]
  description      String?
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  createdBy        User              @relation(fields: [createdById], references: [id])
  appointments     Appointment[]
  inventory        Inventory[]
  medicalReports   MedicalReport[]
  referrals        Referral[]
  followUps        FollowUp[]
  doctorProfiles   DoctorProfile[]   @relation("DoctorCamps")
  volunteerProfiles VolunteerProfile[] @relation("VolunteerCamp")
  campServices     CampService[]
  staffAssignments StaffAssignment[]

  @@map("camps")
}

model Appointment {
  id           String            @id @default(cuid())
  patientId    String
  campId       String
  doctorId     String?
  date         DateTime
  timeSlot     String
  status       AppointmentStatus @default(PENDING)
  queueToken   String?
  notes        String?
  checkedInAt  DateTime?
  qrCode       String?
  noShow       Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  patient      User              @relation("PatientAppointments", fields: [patientId], references: [id])
  camp         Camp              @relation(fields: [campId], references: [id])
  doctor       User?             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  queueTokenRef QueueToken?

  @@unique([patientId, campId, date])
  @@map("appointments")
}

model PatientProfile {
  id               String      @id @default(cuid())
  userId           String      @unique
  dateOfBirth      DateTime?
  gender           Gender?
  bloodGroup       BloodGroup?
  address          String?
  medicalHistory   String?
  allergies        String[]
  emergencyContact Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

model DoctorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  specialization String
  licenseNumber  String   @unique
  experience     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCamps  Camp[]   @relation("DoctorCamps")

  @@map("doctor_profiles")
}

model VolunteerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  skills         String[]
  assignedCampId String?
  attendance     Json[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCamp   Camp?     @relation("VolunteerCamp", fields: [assignedCampId], references: [id])

  @@map("volunteer_profiles")
}

model MedicalReport {
  id             String        @id @default(cuid())
  patientId      String
  doctorId       String
  campId         String
  diagnosis      String
  prescription   String?
  observations   String?
  referral       String?
  isConfidential Boolean       @default(false)
  status         ReportStatus  @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  patient        User          @relation("PatientReports", fields: [patientId], references: [id])
  doctor         User          @relation("DoctorReports", fields: [doctorId], references: [id])
  camp           Camp          @relation(fields: [campId], references: [id])
  vitalSigns     VitalSign[]
  referrals      Referral[]

  @@map("medical_reports")
}

model VitalSign {
  id                    String        @id @default(cuid())
  reportId              String
  bloodPressureSystolic Int?
  bloodPressureDiastolic Int?
  heartRate             Int?
  temperature           Float?
  weight                Float?
  height                Float?
  bloodSugar            Float?
  oxygenSaturation      Float?
  notes                 String?
  createdAt             DateTime      @default(now())

  report                MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("vital_signs")
}

model Referral {
  id           String         @id @default(cuid())
  patientId    String
  doctorId     String
  campId       String
  reportId     String?
  hospitalName String
  department   String
  reason       String
  urgency      String         @default("ROUTINE")
  status       String         @default("PENDING")
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  patient      User           @relation("PatientReferrals", fields: [patientId], references: [id])
  doctor       User           @relation("DoctorReferrals", fields: [doctorId], references: [id])
  camp         Camp           @relation(fields: [campId], references: [id])
  report       MedicalReport? @relation(fields: [reportId], references: [id])

  @@map("referrals")
}

model Inventory {
  id                String                 @id @default(cuid())
  campId            String
  medicineName      String
  genericName       String?
  quantity          Int
  unit              String
  expiryDate        DateTime?
  lowStockThreshold Int                    @default(10)
  supplier          String?
  batchNumber       String?
  category          MedicineCategory       @default(TABLET)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Relations
  camp              Camp                   @relation(fields: [campId], references: [id])
  batches           MedicineBatch[]
  transactions      InventoryTransaction[]

  @@map("inventory")
}

model MedicineBatch {
  id           String    @id @default(cuid())
  inventoryId  String
  batchNumber  String
  quantity     Int
  receivedDate DateTime  @default(now())
  expiryDate   DateTime?
  supplier     String?
  notes        String?
  createdAt    DateTime  @default(now())

  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@map("medicine_batches")
}

model InventoryTransaction {
  id            String          @id @default(cuid())
  inventoryId   String
  type          TransactionType
  quantity      Int
  batchId       String?
  campId        String?
  performedById String?
  reason        String?
  createdAt     DateTime        @default(now())

  inventory     Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  performedBy   User?           @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@map("inventory_transactions")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model FollowUp {
  id            String         @id @default(cuid())
  patientId     String
  doctorId      String
  campId        String
  scheduledDate DateTime
  status        FollowUpStatus @default(PENDING)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  patient       User           @relation("PatientFollowUps", fields: [patientId], references: [id])
  doctor        User           @relation("DoctorFollowUps", fields: [doctorId], references: [id])
  camp          Camp           @relation(fields: [campId], references: [id])

  @@map("follow_ups")
}

model QueueToken {
  id                   String      @id @default(cuid())
  appointmentId        String      @unique
  tokenNumber          Int
  status               QueueStatus @default(WAITING)
  calledAt             DateTime?
  completedAt          DateTime?
  estimatedWaitMinutes Int?
  position             Int?
  createdAt            DateTime    @default(now())

  // Relations
  appointment          Appointment @relation(fields: [appointmentId], references: [id])

  @@map("queue_tokens")
}

model OfflineRegistration {
  id        String    @id @default(cuid())
  data      Json
  synced    Boolean   @default(false)
  createdAt DateTime  @default(now())
  syncedAt  DateTime?

  @@map("offline_registrations")
}

model ConsentRecord {
  id          String      @id @default(cuid())
  userId      String
  consentType ConsentType
  granted     Boolean     @default(true)
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consent_records")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model CampService {
  id           String   @id @default(cuid())
  campId       String
  serviceName  String
  description  String?
  isActive     Boolean  @default(true)
  maxCapacity  Int?
  currentCount Int      @default(0)
  createdAt    DateTime @default(now())

  camp         Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@map("camp_services")
}

model StaffAssignment {
  id          String    @id @default(cuid())
  userId      String
  campId      String
  role        String
  assignedAt  DateTime  @default(now())
  confirmedAt DateTime?
  notes       String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  camp        Camp      @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@unique([userId, campId])
  @@map("staff_assignments")
}
